# Copie para .env e troque TODOS os valores. Nunca versione o .env.
# Senha do SA do SQL Server (mín. 8 caracteres, com maiúscula, minúscula, número e símbolo)
SA_PASSWORD=Troque_Esta_Senha_123
# Primeiro Admin (criado pela API no primeiro start, se não existir nenhum)
ADMIN_EMAIL=admin@pim.local
ADMIN_PASSWORD=Troque_Esta_Senha_123
# Chave de assinatura do JWT (>= 32 caracteres aleatórios)
JWT_SECRET=troque-por-uma-chave-aleatoria-com-mais-de-32-caracteres
# Origens do front permitidas no CORS (separadas por vírgula) - URL do pim-frontend
CORS_ORIGINS=http://localhost:8080
