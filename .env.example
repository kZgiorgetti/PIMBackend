# Copie para .env e preencha. Nunca versione o .env.
# Supabase: painel > Connect > "Session pooler" (porta 5432, usuário postgres.<ref>; funciona em redes IPv4).
# Cole a URI; troque [YOUR-PASSWORD] pela senha do banco (caracteres especiais devem ir codificados: @ = %40).
DB_CONNECTION=postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres
# Primeiro Admin (criado pela API no primeiro start, se não existir nenhum)
ADMIN_EMAIL=admin@pim.local
ADMIN_PASSWORD=Troque_Esta_Senha_123
# Chave de assinatura do JWT (>= 32 caracteres aleatórios)
JWT_SECRET=troque-por-uma-chave-aleatoria-com-mais-de-32-caracteres
# Origens do front permitidas no CORS (separadas por vírgula) - URL do pim-frontend
CORS_ORIGINS=http://localhost:8080
